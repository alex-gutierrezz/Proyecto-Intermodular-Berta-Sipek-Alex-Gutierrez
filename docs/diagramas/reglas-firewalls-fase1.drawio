" parent="1"><mxGeometry x="395.0" y="640" width="460" height="21" as="geometry"/></mxCell><mxCell id="c32" value="Sin esta regla OPNsense bloquearía este tráfico, porque bloquea todo por defecto, y FW02 no podría tomar el relevo" style="text;html=0;fontSize=12;fontColor=#4c1d95;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="175.0" y="700" width="900" height="21" as="geometry"/></mxCell><mxCell id="c33" value="• Verde: reglas por defecto de la LAN" style="text;html=0;fontSize=13;fontColor=#15803d;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="757" width="600" height="22" as="geometry"/></mxCell><mxCell id="c34" value="• Naranja discontinua: regla provisional (TEMPORAL)" style="text;html=0;fontSize=13;fontColor=#c2410c;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="779" width="600" height="22" as="geometry"/></mxCell><mxCell id="c35" value="• Roja discontinua: tráfico bloqueado" style="text;html=0;fontSize=13;fontColor=#dc2626;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="801" width="600" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>