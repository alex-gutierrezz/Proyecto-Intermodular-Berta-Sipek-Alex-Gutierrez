<mxfile host="app.diagrams.net"><diagram name="Reglas firewalls"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1240" pageHeight="836"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Reglas de los firewalls FW01 y FW02 en la Fase 1" style="text;html=0;fontSize=24;fontColor=#111827;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="33" as="geometry"/></mxCell><mxCell id="c2" value="LAN · VLAN 40&#xa;servidores&#xa;192.168.40.0/24" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#16a34a;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="300" height="90" as="geometry"/></mxCell><mxCell id="c3" value="CLIENTES · VLAN 50&#xa;equipos de usuario&#xa;192.168.50.0/24" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f4f6;strokeColor=#6b7280;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="300" height="90" as="geometry"/></mxCell><mxCell id="c4" value="DMZ · VLAN 100&#xa;servidores web&#xa;192.168.100.0/24" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff1f2;strokeColor=#be123c;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="300" height="90" as="geometry"/></mxCell><mxCell id="c5" value="FW01 / FW02&#xa;OPNsense&#xa;&#xa;revisa cada conexión&#xa;con sus reglas" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="240" height="370" as="geometry"/></mxCell><mxCell id="c6" value="Internet&#xa;sale por la WAN con la IP&#xa;192.168.202.86 (NAT)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#374151;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="920" y="150" width="290" height="90" as="geometry"/></mxCell><mxCell id="c7" value="Otras redes internas&#xa;VLAN 40, 50 y 100" style="rounded=1;whiteSpace=wrap;ht