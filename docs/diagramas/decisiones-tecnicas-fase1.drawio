ap;html=1;fillColor=#fff7ed;strokeColor=#d97706;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;" vertex="1" parent="lane1"><mxGeometry x="1118" y="12" width="300" height="84" as="geometry"/></mxCell><mxCell id="lane2" value="Red y&lt;br&gt;firewalls" style="swimlane;horizontal=0;html=1;startSize=170;fillColor=#f3f4f6;swimlaneFillColor=#f3f4f6;strokeColor=#d1d5db;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="326" width="2054" height="108" as="geometry"/></mxCell><mxCell id="c2_0" value="&lt;b&gt;Proxmox como router y NAT (hasta el 19/11)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280;font-size:11px&quot;&gt;✗ OPNsense · pfSense&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d97706;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;" vertex="1" parent="lane2"><mxGeometry x="182" y="12" width="300" height="84" as="geometry"/></mxCell><mxCell id="c2_1" value="&lt;b&gt;OPNsense 26.7 en HA: FW01 + FW02 con CARP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280;font-size:11px&quot;&gt;✗ pfSense · un solo firewall · seguir con Proxmox&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d97706;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;" vertex="1" parent="lane2"><mxGeometry x="494" y="12" width="300" height="84" as="geometry"/></mxCell><mxCell id="c2_2" value="&lt;b&gt;VHID 7 en la WAN; 40, 50 y 100 en las VLAN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280;font-size:11px&quot;&gt;✗ VHID 8 y 34 (ya usados en el aula)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;" vertex="1" parent="lane2"><mxGeometry x="806" y="12" width="300" height="84" as="geometry"/></mxCell><mxCell id="c2_3" value="&lt;b&gt;Relay DHCP de 