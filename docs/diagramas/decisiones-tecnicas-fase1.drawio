es) + Ansible (despliegue)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280;font-size:11px&quot;&gt;✗ Solo PowerShell · solo Ansible&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;" vertex="1" parent="lane6"><mxGeometry x="806" y="12" width="300" height="84" as="geometry"/></mxCell><mxCell id="c6_3" value="&lt;b&gt;WinRM por HTTP con NTLM&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280;font-size:11px&quot;&gt;✗ HTTPS con certificado · Kerberos · OpenSSH&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d97706;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;" vertex="1" parent="lane6"><mxGeometry x="1118" y="12" width="300" height="84" as="geometry"/></mxCell><mxCell id="c6_4" value="&lt;b&gt;Alta de usuarios: script PowerShell lanzado por Ansible&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280;font-size:11px&quot;&gt;✗ microsoft.ad.user · script a mano en DC01&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;" vertex="1" parent="lane6"><mxGeometry x="1430" y="12" width="300" height="84" as="geometry"/></mxCell><mxCell id="c6_5" value="&lt;b&gt;Configurar las Windows con qm guest exec&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280;font-size:11px&quot;&gt;✗ Teclear en noVNC · SConfig&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d97706;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;" vertex="1" parent="lane6"><mxGeometry x="1742" y="12" width="300" height="84" as="geometry"/></mxCell><mxCell id="lane7" value="Secretos y&lt;br&gt;cuentas" style="swimlane;horizontal=0;html=1;startSize=170;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#d1d5db;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="866" width="2054" height="108" as="geometry"/></mxCell><mxCell id="c7_0" value="&lt;b&gt;Ansible Vault (AES256)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280;font-size:11px&quot;&gt;✗ Variables en texto plano&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;" vertex="1" parent="lane7"><mxGeometry x="182" y="12" width="300" height="84" as="geometry"/></mxCell><mxCell id="c7_1" value="&lt;b&gt;Contraseña del vault en /dev/shm&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280;font-size:11px&quot;&gt;✗ --ask-vault-pass · fichero en disco&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d97706;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;" vertex="1" parent="lane7"><mxGeometry x="494" y="12" width="300" height="84" as="geometry"/></mxCell><mxCell id="c7_2" value="&lt;b&gt;Cuenta de servicio automation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280;font-size:11px&quot;&gt;✗ Usar cmkadmin&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;" vertex="1" parent="lane7"><mxGeometry x="806" y="12" width="300" height="84" as="geometry"/></mxCell><mxCell id="lane8" value="Monitorización y&lt;br&gt;documentación" style="swimlane;horizontal=0;html=1;startSize=170;fillColor=#f3f4f6;swimlaneFillColor=#f3f4f6;strokeColor=#d1d5db;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="974" width="2054" height="108" as="geometry"/></mxCell><mxCell id="c8_0" value="&lt;b&gt;Checkmk 2.5 Community&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280;font-size:11px&quot;&gt;✗ Zabbix · Prometheus + Grafana&lt;/span&gt;" style="rounded=1;whi