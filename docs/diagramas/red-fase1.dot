digraph red {
graph [rankdir=LR, compound=true, fontname="Inter", bgcolor="#ffffff", pad=0.5, nodesep=0.3, ranksep=0.6, splines=spline,
 label=<<FONT POINT-SIZE="20" COLOR="#1a202c"><B>CiberNova</B></FONT><FONT POINT-SIZE="20" COLOR="#718096">  ·  Red de la Fase 1</FONT><BR/><FONT POINT-SIZE="11" COLOR="#718096">proxmoxAB</FONT>>, labelloc=t, labeljust=l];
node [fontname="Inter", shape=plain];
edge [fontname="Inter", fontsize=9, color="#a0aec0", fontcolor="#718096", penwidth=1.6, arrowsize=0.7];

aula [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#4a5568" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="11"><B>🌐  Red del aula</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">192.168.200.0/22</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">Gateway / Internet: 192.168.200.254</FONT></TD></TR></TABLE>>];
subgraph cluster_pve {
label=<<FONT POINT-SIZE="13" COLOR="#1a202c"><B>proxmoxAB · Proxmox VE 9.2.2</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#718096">2x Xeon E5-2620 v2 · 128 GB RAM · 4x900 GB RAID 10</FONT>>;
style="rounded,filled"; fillcolor="#fbfbfd"; color="#cbd5e0"; penwidth=1.5; labeljust=l; margin=18;
vmbr0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#3182ce" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="11"><B>vmbr0 · nic1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">192.168.202.7/22</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">https://192.168.202.7:8006</FONT></TD></TR></TABLE>>];
subgraph cluster_fw { label=<<FONT POINT-SIZE="12" COLOR="#b7791f"><B>Firewalls OPNsense 26.7 en HA (CARP)</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#718096">el tráfico entre vmbr0 y vmbr1 solo pasa por aquí</FONT>>;
style="rounded,filled"; fillcolor="#fffbeb"; color="#d69e2e"; penwidth=1.5; labeljust=l; margin=14;
vipw [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#d69e2e" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="11"><B>VIP WAN · VHID 7</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">192.168.202.86</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">NAT de salida de las VLAN 40, 50 y 100</FONT></TD></TR></TABLE>>];
fw1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="11"><B>FW01 · VM 113 · MASTER</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">WAN 192.168.202.84</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">LAN .40.2 · CLI .50.2 · DMZ .100.2</FONT></TD></TR></TABLE>>];
sync [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#6b46c1" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="11"><B>VLAN 99 · SYNC (192.168.99.0/24)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">FW01 .1 ↔ FW02 .2</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">pfsync + XMLRPC</FONT></TD></TR></TABLE>>];
fw2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#3182ce" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="11"><B>FW02 · VM 114 · BACKUP</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">WAN 192.168.202.85</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">LAN .40.3 · CLI .50.3 · DMZ .100.3</FONT></TD></TR></TABLE>>];
vipi [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#d69e2e" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="11"><B>VIP internas (puertas de enlace)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">LAN 192.168.40.1 · VHID 40</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">CLIENTES 192.168.50.1 · VHID 50</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">DMZ 192.168.100.1 · VHID 100</FONT></TD></TR></TABLE>>];
{rank=same; fw1; sync; fw2;}
fw1 -> sync [dir=none, color="#6b46c1", penwidth=2.2]; sync -> fw2 [dir=none, color="#6b46c1", penwidth=2.2];
}

vmbr1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#3182ce" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="11"><B>vmbr1 · bridge interno</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">VLAN-aware</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">sin tarjeta física: no toca la red del aula</FONT></TD></TR></TABLE>>];
v40 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="11"><B>vmbr1.40 · gestión</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">192.168.40.4/24 (gestión)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">rutas a .50 y .100 vía .40.1</FONT></TD></TR></TABLE>>];
subgraph cluster_vlan40 { label=<<FONT POINT-SIZE="12" COLOR="#2f855a"><B>VLAN 40 · Servidores internos</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#718096">192.168.40.0/24 · tag 40</FONT>>;
style="rounded,filled"; fillcolor="#f0fff4"; color="#2f855a"; penwidth=1.5; labeljust=l; margin=14;
v40grid [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="10"><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" WIDTH="150"><TR><TD BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>Ansible</B></FONT>  <FONT COLOR="white" POINT-SIZE="8">VM 111</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1a202c"><B>.5</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#c05621">Ubuntu 24.04</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#718096">Nodo de control</FONT></TD></TR></TABLE></TD><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" WIDTH="150"><TR><TD BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>DC01</B></FONT>  <FONT COLOR="white" POINT-SIZE="8">VM 100</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1a202c"><B>.10</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b6cb0">WS2025</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#718096">AD + DNS</FONT></TD></TR></TABLE></TD><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" WIDTH="150"><TR><TD BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>DC02</B></FONT>  <FONT COLOR="white" POINT-SIZE="8">VM 101</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1a202c"><B>.11</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b6cb0">WS2025</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#718096">AD + DNS</FONT></TD></TR></TABLE></TD><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" WIDTH="150"><TR><TD BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>DHCP01</B></FONT>  <FONT COLOR="white" POINT-SIZE="8">VM 102</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1a202c"><B>.12</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b6cb0">WS2025</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#718096">DHCP failover</FONT></TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" WIDTH="150"><TR><TD BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>DHCP02</B></FONT>  <FONT COLOR="white" POINT-SIZE="8">VM 104</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1a202c"><B>.13</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b6cb0">WS2025</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#718096">DHCP failover</FONT></TD></TR></TABLE></TD><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" WIDTH="150"><TR><TD BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>CMK</B></FONT>  <FONT COLOR="white" POINT-SIZE="8">VM 112</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1a202c"><B>.20</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#c05621">Ubuntu</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#718096">Checkmk 2.5</FONT></TD></TR></TABLE></TD><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" WIDTH="150"><TR><TD BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>FILES01</B></FONT>  <FONT COLOR="white" POINT-SIZE="8">VM 108</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1a202c"><B>.30</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b6cb0">WS2025</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#718096">DFS</FONT></TD></TR></TABLE></TD><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" WIDTH="150"><TR><TD BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>FILES02</B></FONT>  <FONT COLOR="white" POINT-SIZE="8">VM 109</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1a202c"><B>.31</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b6cb0">WS2025</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#718096">DFS</FONT></TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" WIDTH="150"><TR><TD BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>DB01</B></FONT>  <FONT COLOR="white" POINT-SIZE="8">VM 106</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1a202c"><B>.40</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#c05621">Ubuntu</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#718096">MariaDB</FONT></TD></TR></TABLE></TD><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" WIDTH="150"><TR><TD BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>DB02</B></FONT>  <FONT COLOR="white" POINT-SIZE="8">VM 107</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1a202c"><B>.41</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#c05621">Ubuntu</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#718096">MariaDB</FONT></TD></TR></TABLE></TD><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" WIDTH="150"><TR><TD BGCOLOR="#2f855a" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="10"><B>BACKUP</B></FONT>  <FONT COLOR="white" POINT-SIZE="8">VM 110</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1a202c"><B>.50</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b6cb0">WS2025</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#718096">Copias</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
}
subgraph cluster_vlan50 { label=<<FONT POINT-SIZE="12" COLOR="#6b46c1"><B>VLAN 50 · Clientes</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#718096">192.168.50.0/24 · tag 50</FONT>>;
style="rounded,filled"; fillcolor="#faf5ff"; color="#6b46c1"; penwidth=1.5; labeljust=l; margin=14;
cli [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#ffffff" STYLE="ROUNDED"><TR><TD BGCOLOR="#6b46c1" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="11"><B>Equipos cliente</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">Ámbito DHCP .20 a .250</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">(DHCP01 y DHCP02)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#1a202c">Relay en OPNsense: pendiente</FONT></TD></TR></TABLE>>];
}
subgraph cluster_vlan100 { label=<<FONT POINT-SIZE="12" COLOR="#dd6b20"><B>VLAN 100 · DMZ</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#718096">192.168.100.0/24 · tag 100</FONT>>;
style="rounded,filled"; fillcolor="#fffaf0"; color="#dd6b20"; penwidth=1.5; labeljust=l; margin=14;
n103 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" WIDTH="150">
<TR><TD BGCOLOR="#dd6b20" ALIGN="LEFT" WIDTH="150" FIXEDSIZE="FALSE"><FONT COLOR="white" POINT-SIZE="10"><B>WEB01</B></FONT>  <FONT COLOR="white" POINT-SIZE="8">VM 103</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1a202c"><B>.30</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#c05621">Ubuntu</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="150" HEIGHT="20"><FONT POINT-SIZE="9" COLOR="#718096">Web + SFTP</FONT></TD></TR>
</TABLE>>];
n105 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#ffffff" WIDTH="150">
<TR><TD BGCOLOR="#dd6b20" ALIGN="LEFT" WIDTH="150" FIXEDSIZE="FALSE"><FONT COLOR="white" POINT-SIZE="10"><B>WEB02</B></FONT>  <FONT COLOR="white" POINT-SIZE="8">VM 105</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1a202c"><B>.31</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#c05621">Ubuntu</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="150" HEIGHT="20"><FONT POINT-SIZE="9" COLOR="#718096">Web + SFTP</FONT></TD></TR>
</TABLE>>];
n103 -> n105 [style=invis]; }
tpl [label=<<TABLE BORDER="1" COLOR="#718096" STYLE="ROUNDED,DASHED" CELLPADDING="6" BGCOLOR="#fbfbfd"><TR><TD><FONT POINT-SIZE="10" COLOR="#718096"><B>VM 9000 · ubuntu-2404-tpl</B><BR/>Plantilla cloud-init (sin red)</FONT></TD></TR></TABLE>>];
}
aula -> vmbr0 [dir=both, label="  salida al aula  "];
vmbr0 -> vipw [dir=both, label="  WAN  "];
vipw -> fw1 [color="#2f855a", label=" activo "]; vipw -> fw2 [color="#3182ce", style=dashed, label=" relevo "];
fw1 -> vipi [color="#2f855a"]; fw2 -> vipi [color="#3182ce", style=dashed];
vipi -> vmbr1 [dir=both, label="  LAN, CLIENTES y DMZ  "];
vmbr1 -> v40grid [lhead=cluster_vlan40, headlabel=<<FONT COLOR="#2f855a" POINT-SIZE="10"><B>tag 40 · gw .40.1</B></FONT>>, labeldistance=9, labelangle=-6, color="#2f855a"];
vmbr1 -> cli [lhead=cluster_vlan50, label="  tag 50 · gw .50.1  ", color="#6b46c1"];
vmbr1 -> n103 [lhead=cluster_vlan100, label="  tag 100 · gw .100.1  ", color="#dd6b20"];
vmbr1 -> v40 [style=dashed, arrowhead=none];
v40 -> v40grid [lhead=cluster_vlan40, style=dashed, label="  gestión de Proxmox  ", color="#2f855a"];
vmbr1 -> tpl [style=invis];
}
