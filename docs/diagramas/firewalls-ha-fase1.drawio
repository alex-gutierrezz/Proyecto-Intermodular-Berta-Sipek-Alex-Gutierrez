<mxfile host="app.diagrams.net"><diagram name="Firewalls HA"><mxGraphModel dx="1400" dy="972" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="972"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Firewalls FW01 y FW02: interfaces, IP y redes que protegen" style="text;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="host" value="proxmoxAB (192.168.202.7): el servidor físico (host) donde corren todas las VMs&#xa;Si este servidor cae, caen FW01 y FW02 a la vez" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=12;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1320" height="808" as="geometry"/></mxCell><mxCell id="aula" value="&lt;b&gt;Red del aula 192.168.200.0/22&lt;/b&gt;&lt;br&gt;Puerta de enlace 192.168.200.254" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="70" width="500" height="60" as="geometry"/></mxCell><mxCell id="vipw" value="&lt;b&gt;VIP WAN 192.168.202.86 · VHID 7&lt;/b&gt;&lt;br&gt;(.202.87 libre de reserva)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d97706;strokeWidth=2;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="500" y="186" width="400" height="52" as="geometry"/></mxCell><mxCell id="fw1" value="&lt;b&gt;FW01 (VM 113) · MASTER&lt;/b&gt;&lt;br&gt;&lt;i&gt;v. OPNsense 26.7 · IP propias:&lt;/i&gt;&lt;br&gt;• WAN: 192.168.202.84&lt;br&gt;• LAN: 192.168.40.2&lt;br&gt;• CLIENTES: 192.168.50.2&lt;br&gt;• DMZ: 192.168.100.2&lt;br&gt;• SYNC: 192.168.99.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#16a34a;strokeWidth=2;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="150" y="262" width="330" height="206" as="geometry"/></mxCell><mxCell id="fw2" value="&lt;b&gt;FW02 (VM 114) · BACKUP&lt;/b&gt;&lt;br&gt;&lt;i&gt;v. OPNsense 26.7 · IP propias:&lt;/i&gt;&lt;br&gt;• WAN: 192.168.202.85&lt;br&gt;• LAN: 192.168.40.3&lt;br&gt;• CLIENTES: 192.168.50.3&lt;br&gt;• DMZ: 192.168.100.3&lt;br&gt;• SYNC: 192.168.99.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="920" y="262" width="330" height="206" as="geometry"/></mxCell><mxCell id="sync" value="&lt;b&gt;VLAN 99 · SYNC&lt;/b&gt;&lt;br&gt;192.168.99.0/24&lt;br&gt;pfsync + XMLRPC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="280" height="80" as="geometry"/></mxCell><mxCell id="vips" value="&lt;b&gt;VIP CARP = puertas de enlace de las redes internas (IP compartidas por FW01 y FW02)&lt;/b&gt;&lt;br&gt;LAN 192.168.40.1 (VHID 40)  ·  CLIENTES 192.168.50.1 (VHID 50)  ·  DMZ 192.168.100.1 (VHID 100)&lt;br&gt;Las tiene el firewall MASTER; si cae, el BACKUP las asume en segundos y los equipos no notan el cambio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d97706;strokeWidth=2;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="120" y="512" width="1160" height="74" as="geometry"/></mxCell><mxCell id="v40" value="&lt;b&gt;VLAN 40 · Servidores&lt;/b&gt;&lt;br&gt;&lt;i&gt;192.168.40.0/24 · gateway .40.1&lt;/i&gt;&lt;br&gt;• Gestión: Proxmox .4 · Ansible .5&lt;br&gt;• AD y DNS: DC01 .10 · DC02 .11&lt;br&gt;• DHCP: DHCP01 .12 · DHCP02 .13&lt;br&gt;• Monitorización: CMK .20&lt;br&gt;• Ficheros: FILES01 .30 · FILES02 .31&lt;br&gt;• Datos: DB01 .40 · DB02 .41 · BACKUP .50" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=2;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="80" y="622" width="400" height="220" as="geometry"/></mxCell><mxCell id="v50" value="&lt;b&gt;VLAN 50 · Clientes&lt;/b&gt;&lt;br&gt;&lt;i&gt;192.168.50.0/24 · gateway .50.1&lt;/i&gt;&lt;br&gt;• Ámbito DHCP: .20 a .250&lt;br&gt;• Lo reparten DHCP01 y DHCP02&lt;br&gt;• Relay DHCP en OPNsense: pendiente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=2;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="500" y="622" width="400" height="220" as="geometry"/></mxCell><mxCell id="v100" value="&lt;b&gt;VLAN 100 · DMZ&lt;/b&gt;&lt;br&gt;&lt;i&gt;192.168.100.0/24 · gateway .100.1&lt;/i&gt;&lt;br&gt;• Web: WEB01 .30 · WEB02 .31" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=2;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="920" y="622" width="400" height="220" as="geometry"/></mxCell><mxCell id="nat" value="&lt;b&gt;NAT de salida: lo que sale de las VLAN 40, 50 y 100 a Internet lleva la IP de la VIP WAN 192.168.202.86&lt;/b&gt;&lt;br&gt;Como esa IP siempre la tiene el firewall activo, un failover no cambia la IP de salida&lt;br&gt;Proxmox llega a las VLAN 50 y 100 por rutas estáticas a través de 192.168.40.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="862" width="1240" height="74" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;strokeColor=#374151;strokeWidth=2;fontColor=#374151;" edge="1" parent="1" source="aula" target="vipw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="activo" style="endArrow=block;strokeColor=#374151;strokeWidth=2;fontColor=#374151;" edge="1" parent="1" source="vipw" target="fw1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="relevo" style="endArrow=block;strokeColor=#2563eb;strokeWidth=2;fontColor=#2563eb;dashed=1;" edge="1" parent="1" source="vipw" target="fw2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="activo" style="endArrow=block;strokeColor=#374151;strokeWidth=2;fontColor=#374151;" edge="1" parent="1" source="fw1" target="vips"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="relevo" style="endArrow=block;strokeColor=#2563eb;strokeWidth=2;fontColor=#2563eb;dashed=1;" edge="1" parent="1" source="fw2" target="vips"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=block;strokeColor=#374151;strokeWidth=2;fontColor=#374151;" edge="1" parent="1" source="vips" target="v40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArrow=block;strokeColor=#374151;strokeWidth=2;fontColor=#374151;" edge="1" parent="1" source="vips" target="v50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=block;strokeColor=#374151;strokeWidth=2;fontColor=#374151;" edge="1" parent="1" source="vips" target="v100"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s0" style="endArrow=none;strokeColor=#7c3aed;strokeWidth=3;" edge="1" parent="1" source="fw1" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1" style="endArrow=none;strokeColor=#7c3aed;strokeWidth=3;" edge="1" parent="1" source="sync" target="fw2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>