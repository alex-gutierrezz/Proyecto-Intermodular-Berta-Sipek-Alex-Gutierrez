<mxfile host="app.diagrams.net"><diagram name="Firewalls HA"><mxGraphModel dx="1400" dy="930" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="930"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Firewalls FW01 y FW02 en alta disponibilidad (CARP) · estado a 19/11/2026" style="text;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="sub" value="Todo corre dentro de proxmoxAB (192.168.202.7): la HA cubre la caída de una VM, no la del host" style="text;fontSize=14;fontColor=#4b5563;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="900" height="24" as="geometry"/></mxCell><mxCell id="host" value="proxmoxAB · vmbr0 (aula) y vmbr1 (VLAN-aware)" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=12;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1320" height="760" as="geometry"/></mxCell><mxCell id="aula" value="Red del aula 192.168.200.0/22&#xa;Puerta de enlace 192.168.200.254" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="70" width="500" height="60" as="geometry"/></mxCell><mxCell id="vipw" value="VIP WAN 192.168.202.86 · VHID 7&#xa;(.202.87 libre de reserva)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#d97706;strokeWidth=2;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="500" y="170" width="400" height="54" as="geometry"/></mxCell><mxCell id="fw1" value="FW01 · VM 113 · MASTER&#xa;OPNsense 26.7&#xa;WAN 192.168.202.84 · LAN 192.168.40.2&#xa;CLIENTES 192.168.50.2 · DMZ 192.168.100.2&#xa;SYNC 192.168.99.1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#16a34a;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="270" width="400" height="150" as="geometry"/></mxCell><mxCell id="fw2" value="FW02 · VM 114 · BACKUP&#xa;OPNsense 26.7&#xa;WAN 192.168.202.85 · LAN 192.168.40.3&#xa;CLIENTES 192.168.50.3 · DMZ 192.168.100.3&#xa;SYNC 192.168.99.2" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="850" y="270" width="400" height="150" as="geometry"/></mxCell><mxCell id="sync" value="VLAN 99 · SYNC · 192.168.99.0/24&#xa;pfsync: copia las conexiones&#xa;XMLRPC: copia la configuración" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="280" height="90" as="geometry"/></mxCell><mxCell id="vips" value="VIP CARP (puertas de enlace): LAN 192.168.40.1 · VHID 40   |   CLIENTES 192.168.50.1 · VHID 50   |   DMZ 192.168.100.1 · VHID 100&#xa;Las tiene el MASTER; si deja de anunciarse, el BACKUP las asume en segundos" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#d97706;strokeWidth=2;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="120" y="480" width="1160" height="56" as="geometry"/></mxCell><mxCell id="v40" value="VLAN 40 · Servidores · 192.168.40.0/24&#xa;Gateway 192.168.40.1&#xa;Proxmox .4 (gestión) · Ansible .5&#xa;DC01 .10 · DC02 .11&#xa;DHCP01 .12 · DHCP02 .13 · CMK .20&#xa;FILES01 .30 · FILES02 .31&#xa;DB01 .40 · DB02 .41 · BACKUP .50" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="590" width="400" height="210" as="geometry"/></mxCell><mxCell id="v50" value="VLAN 50 · Clientes · 192.168.50.0/24&#xa;Gateway 192.168.50.1&#xa;Ámbito DHCP .20 a .250&#xa;(lo reparten DHCP01 y DHCP02)&#xa;Relay DHCP en OPNsense: pendiente" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="590" width="400" height="210" as="geometry"/></mxCell><mxCell id="v100" value="VLAN 100 · DMZ · 192.168.100.0/24&#xa;Gateway 192.168.100.1&#xa;WEB01 .30 · WEB02 .31" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="590" width="400" height="210" as="geometry"/></mxCell><mxCell id="nat" value="NAT de salida: REDES_INTERNAS (VLAN 40, 50 y 100) → VIP WAN 192.168.202.86, así el failover no rompe las conexiones&#xa;Proxmox llega a las VLAN 50 y 100 por rutas estáticas vía 192.168.40.1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6b7280;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="830" width="1240" height="50" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;strokeColor=#374151;strokeWidth=2;fontColor=#374151;" edge="1" parent="1" source="aula" target="vipw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="activo" style="endArrow=block;strokeColor=#374151;strokeWidth=2;fontColor=#374151;" edge="1" parent="1" source="vipw" target="fw1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="relevo" style="endArrow=block;strokeColor=#2563eb;strokeWidth=2;fontColor=#2563eb;dashed=1;" edge="1" parent="1" source="vipw" target="fw2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="activo" style="endArrow=block;strokeColor=#374151;strokeWidth=2;fontColor=#374151;" edge="1" parent="1" source="fw1" target="vips"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="relevo" style="endArrow=block;strokeColor=#2563eb;strokeWidth=2;fontColor=#2563eb;dashed=1;" edge="1" parent="1" source="fw2" target="vips"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=block;strokeColor=#374151;strokeWidth=2;fontColor=#374151;" edge="1" parent="1" source="vips" target="v40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArrow=block;strokeColor=#374151;strokeWidth=2;fontColor=#374151;" edge="1" parent="1" source="vips" target="v50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=block;strokeColor=#374151;strokeWidth=2;fontColor=#374151;" edge="1" parent="1" source="vips" target="v100"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s0" style="endArrow=none;strokeColor=#7c3aed;strokeWidth=3;" edge="1" parent="1" source="fw1" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1" style="endArrow=none;strokeColor=#7c3aed;strokeWidth=3;" edge="1" parent="1" source="sync" target="fw2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>