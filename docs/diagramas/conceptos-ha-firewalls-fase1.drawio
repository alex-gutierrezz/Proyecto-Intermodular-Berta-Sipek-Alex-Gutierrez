<mxfile host="app.diagrams.net"><diagram name="Conceptos HA firewalls"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1240" pageHeight="878"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Cómo funcionan juntos los conceptos de red de los firewalls" style="text;html=0;fontSize=24;fontColor=#111827;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="33" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="1180" height="190" as="geometry"/></mxCell><mxCell id="c3" value="Red del aula = WAN de los firewalls · 192.168.200.0/22 (compartida con toda la clase)" style="text;html=0;fontSize=15;fontColor=#1e3a8a;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="113" width="900" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Otro equipo del aula&#xa;VHID 8 · 192.168.202.38" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=12;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="250" height="64" as="geometry"/></mxCell><mxCell id="c5" value="Otro equipo del aula&#xa;VHID 34 · 192.168.202.35" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=12;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="222" width="250" height="54" as="geometry"/></mxCell><mxCell id="c6" value="VIP de la WAN · 192.168.202.86&#xa;VHID 7 · la tiene el MASTER&#xa;sale a Internet con esta IP (NAT)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#1d4ed8;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="165" width="300" height="80" as="geometry"/></mxCell><mxCell id="c7" value="Anuncios CARP (multicast 224.0.0.18)&#xa;cada 1 s: «la IP del VHID 7 es mía»&#xa;los oye todo el aula: cada pareja&#xa;necesita un VHID distinto" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#2563eb;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="900" y="160" width="280" height="90" as="geometry"/></mxCell><mxCell id="c8" value="FW01 · OPNsense · MASTER&#xa;CARP advskew 0 (prioridad alta)&#xa;WAN real: 192.168.202.84&#xa;LAN real: 192.168.40.2&#xa;SYNC: 192.168.99.1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#16a34a;fontSize=13;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="330" height="150" as="geometry"/></mxCell><mxCell id="c9" value="FW02 · OPNsense · BACKUP&#xa;CARP advskew 100 (espera)&#xa;WAN real: 192.168.202.85&#xa;LAN real: 192.168.40.3&#xa;SYNC: 192.168.99.2" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#d97706;fontSize=13;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="850" y="380" width="330" height="150" as="geometry"/></mxCell><mxCell id="c10" style="endArrow=block;html=0;strokeColor=#374151;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="378" as="sourcePoint"/><mxPoint x="560" y="247" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="FW01 tiene la VIP&#xa;y envía los anuncios" style="text;html=0;fontSize=12;fontColor=#065f46;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="120" y="310" width="200" height="38" as="geometry"/></mxCell><mxCell id="c12" value="interfaz WAN ↑" style="text;html=0;fontSize=12;fontColor=#1e3a8a;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="318" y="360" width="150" height="21" as="geometry"/></mxCell><mxCell id="c13" style="endArrow=block;html=0;strokeColor=#374151;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="378" as="sourcePoint"/><mxPoint x="690" y="247" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="si FW02 deja de oír a FW01,&#xa;se queda la VIP" style="text;html=0;fontSize=12;fontColor=#92400e;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="880" y="310" width="220" height="38" as="geometry"/></mxCell><mxCell id="c15" value="interfaz WAN ↑" style="text;html=0;fontSize=12;fontColor=#1e3a8a;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="958" y="360" width="150" height="21" as="geometry"/></mxCell><mxCell id="c16" value="VLAN 99 · SYNC&#xa;enlace privado entre los dos&#xa;firewalls (la regla SYNC&#xa;lo permite)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f3ff;strokeColor=#7c3aed;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="395" width="300" height="105" as="geometry"/></mxCell><mxCell id="c17" style="endArrow=block;html=0;strokeColor=#7c3aed;strokeWidth=2;startArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="392" y="447" as="sourcePoint"/><mxPoint x="468" y="447" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" style="endArrow=block;html=0;strokeColor=#7c3aed;strokeWidth=2;startArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="772" y="447" as="sourcePoint"/><mxPoint x="848" y="447" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="pfsync&#xa;copia las conexiones&#xa;abiertas" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#7c3aed;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="535" width="190" height="62" as="geometry"/></mxCell><mxCell id="c20" value="XMLRPC&#xa;copia la configuración&#xa;de FW01 a FW02" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#7c3aed;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="630" y="535" width="190" height="62" as="geometry"/></mxCell><mxCell id="c21" style="endArrow=block;html=0;strokeColor=#7c3aed;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="502" as="sourcePoint"/><mxPoint x="530" y="533" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" style="endArrow=block;html=0;strokeColor=#7c3aed;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="502" as="sourcePoint"/><mxPoint x="715" y="533" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1180" height="180" as="geometry"/></mxCell><mxCell id="c24" value="VIP de la LAN · 192.168.40.1&#xa;VHID 40 · puerta de enlace&#xa;de todos los servidores" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="650" width="300" height="74" as="geometry"/></mxCell><mxCell id="c25" value="Servidores (DC01, DHCP01, CMK...)&#xa;solo conocen la .40.1:&#xa;no notan qué firewall responde" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#16a34a;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="654" width="300" height="66" as="geometry"/></mxCell><mxCell id="c26" style="endArrow=block;html=0;strokeColor=#374151;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="532" as="sourcePoint"/><mxPoint x="520" y="648" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="interfaz LAN ↓" style="text;html=0;fontSize=12;fontColor=#14532d;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="80" y="556" width="150" height="21" as="geometry"/></mxCell><mxCell id="c28" style="endArrow=block;html=0;strokeColor=#374151;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1015" y="532" as="sourcePoint"/><mxPoint x="720" y="648" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" style="endArrow=block;html=0;strokeColor=#374151;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="876" y="687" as="sourcePoint"/><mxPoint x="774" y="687" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="Red interna = LAN · VLAN 40 · 192.168.40.0/24. CLIENTES (50) y DMZ (100) funcionan igual, cada una con su VIP y su VHID." style="text;html=0;fontSize=14;fontColor=#14532d;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="771" width="1150" height="23" as="geometry"/></mxCell><mxCell id="leg" value="HA (alta disponibilidad) = CARP (IP compartida que pasa de un firewall a otro) + pfsync (las conexiones no se cortan) + XMLRPC (los dos tienen la misma configuración). FW01 es el firewall activo, pero si deja de funcionar, FW02 coge el relevo y así se mantiene la alta disponibilidad." style="text;html=0;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="818" width="1160" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>