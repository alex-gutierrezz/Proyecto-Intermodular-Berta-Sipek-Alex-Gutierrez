<mxfile host="app.diagrams.net"><diagram name="DHCP y red del aula"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1270" pageHeight="480"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="¿Por qué este DHCP no puede dar IP en el aula?" style="text;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="32" as="geometry"/></mxCell><mxCell id="st" value="El ámbito de DHCP01 y DHCP02 no alcanza la red del aula: no tienen ninguna interfaz en vmbr0 y el broadcast DHCP no cruza el router" style="text;fontSize=14;fontColor=#4b5563;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1190" height="24" as="geometry"/></mxCell><mxCell id="c0" value="Red del aula &#183; 192.168.200.0/22" style="swimlane;startSize=54;rounded=1;fillColor=#9ca3af;swimlaneFillColor=#f9fafb;strokeColor=#9ca3af;fontColor=#ffffff;fontStyle=1;fontSize=14;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="330" height="236" as="geometry"/></mxCell><mxCell id="c0_0" value="PC del aula&#xa;Pide su IP con un broadcast DHCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#000000;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="c0"><mxGeometry x="12" y="66" width="306" height="52" as="geometry"/></mxCell><mxCell id="c0_1" value="Puerta de enlace 192.168.200.254&#xa;La red la gestiona el centro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#000000;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="c0"><mxGeometry x="12" y="128" width="306" height="52" as="geometry"/></mxCell><mxCell id="c1" value="vmbr0 &#183; único bridge con tarjeta física (nic1)" style="swimlane;startSize=54;rounded=1;fillColor=#d97706;swimlaneFillColor=#fff7ed;strokeColor=#d97706;fontColor=#ffffff;fontStyle=1;fontSize=14;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="330" height="236" as="geometry"/></mxCell><mxCell id="c1_0" value="WAN de FW01 y FW02" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontColor=#000000;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="12" y="66" width="306" height="52" as="geometry"/></mxCell><mxCell id="c1_1" value="Gestión de Proxmox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontColor=#000000;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="12" y="128" width="306" height="52" as="geometry"/></mxCell><mxCell id="c1_2" value="Aquí no hay ningún DHCP ni relay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontColor=#be123c;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="12" y="190" width="306" height="52" as="geometry"/></mxCell><mxCell id="c2" value="vmbr1 &#183; sin ninguna tarjeta física" style="swimlane;startSize=54;rounded=1;fillColor=#2563eb;swimlaneFillColor=#eff6ff;strokeColor=#2563eb;fontColor=#ffffff;fontStyle=1;fontSize=14;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="920" y="120" width="310" height="236" as="geometry"/></mxCell><mxCell id="c2_0" value="VLAN 40 &#183; DHCP01 .12 y DHCP02 .13&#xa;Su única interfaz está aquí" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#000000;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="c2"><mxGeometry x="12" y="66" width="286" height="52" as="geometry"/></mxCell><mxCell id="c2_1" value="VLAN 50 &#183; clientes&#xa;Llega por el relay de OPNsense" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#000000;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="c2"><mxGeometry x="12" y="128" width="286" height="52" as="geometry"/></mxCell><mxCell id="c2_2" value="VLAN 100 &#183; DMZ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#000000;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="c2"><mxGeometry x="12" y="190" width="286" height="52" as="geometry"/></mxCell><mxCell id="a0" value="broadcast DHCP" style="endArrow=blockThin;html=1;dashed=0;strokeColor=#4b5563;fontColor=#4b5563;strokeWidth=2;fontSize=12;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="238" as="sourcePoint"/><mxPoint x="480" y="238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a1" value="el broadcast no cruza" style="endArrow=none;html=1;dashed=1;strokeColor=#be123c;fontColor=#be123c;strokeWidth=2;fontSize=12;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="238" as="sourcePoint"/><mxPoint x="920" y="238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="x1" value="&#10005;" style="text;fontSize=22;fontStyle=1;fontColor=#be123c;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="851.0" y="224" width="28" height="28" as="geometry"/></mxCell><mxCell id="n" value="Resultado: el ámbito solo reparte en la VLAN 40 y, a través del relay de OPNsense, en la VLAN 50. La red del aula queda fuera por diseño, porque lo exige el enunciado, y también por configuración." style="text;fontSize=14;align=left;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="382" width="1190" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>