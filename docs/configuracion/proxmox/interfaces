auto lo
iface lo inet loopback

iface nic1 inet manual

iface nic0 inet manual

iface nic2 inet manual

iface nic3 inet manual

auto vmbr0
iface vmbr0 inet static
        address 192.168.202.7/22
        gateway 192.168.200.254
        bridge-ports nic1
        bridge-stp off
        bridge-fd 0

auto vmbr1
iface vmbr1 inet manual
    bridge-ports none
    bridge-stp off
    bridge-fd 0
    bridge-vlan-aware yes
    bridge-vids 2-4094

auto vmbr1.40
iface vmbr1.40 inet static
    address 192.168.40.4/24
    # Desde 19/11/2026 la puerta de enlace de las VLAN es la VIP CARP de los firewalls (.1)
    post-up ip route replace 192.168.50.0/24 via 192.168.40.1
    post-up ip route replace 192.168.100.0/24 via 192.168.40.1

source /etc/network/interfaces.d/*
